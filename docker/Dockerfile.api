ARG PYTHON_IMAGE=python:3.12.12-slim
FROM ${PYTHON_IMAGE}

USER root

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-deps . && \
    pip install \
      fastapi==0.141.1 google-api-python-client==2.187.0 google-auth==2.41.1 \
      google-cloud-batch==0.20.0 google-cloud-firestore==2.21.0 \
      google-cloud-pubsub==2.31.1 google-cloud-storage==3.4.0 httpx==0.28.1 \
      h5py==3.16.0 numpy==2.2.6 openai==3.16.2 \
      openai-agents==0.22.3 pydantic==2.13.5 \
      pydantic-settings==2.15.0 python-multipart==0.0.31 PyYAML==6.0.3 \
      slack-bolt==1.27.0 slack-sdk==3.39.0 aiohttp==3.14.3 uvicorn==0.41.0

USER 65532:65532
EXPOSE 8080
CMD ["uvicorn", "pistachio.api.app:app", "--host", "0.0.0.0", "--port", "8080"]
