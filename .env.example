PISTACHIO_ENV=local
PISTACHIO_STORE_BACKEND=memory
PISTACHIO_EXECUTION_BACKEND=local
PISTACHIO_AUTH_MODE=dev
PISTACHIO_WEB_SESSION_DAYS=14
PISTACHIO_ALLOWED_EMAILS=["researcher@example.org"]
PISTACHIO_DEV_USER_EMAIL=researcher@example.org
PISTACHIO_CONTROL_PLANE_URL=http://localhost:8080
PISTACHIO_OIDC_AUDIENCE=
PISTACHIO_OAUTH_CLIENT_ID=
PISTACHIO_OAUTH_CLIENT_SECRET=
PISTACHIO_OPENAI_MODEL=gpt-5.6-sol
PISTACHIO_OPENAI_REASONING_EFFORT=medium
PISTACHIO_PLANNER_VERSION=2
# Builder protocol 2 is opt-in. See docs/code-builder-implementation.md for release gates.
PISTACHIO_BUILDER_PROTOCOL_VERSION=1
PISTACHIO_DEVELOPMENT_ENABLED=false
PISTACHIO_DEVELOPMENT_MODEL=gpt-5.6-sol
PISTACHIO_DEVELOPMENT_PREPARATION_ENABLED=true
# Version 2: enable only after matched-image and scientific conformance checks.
PISTACHIO_DEVELOPMENT_LATENCY_ENABLED=false
PISTACHIO_WORKER_SESSIONS_ENABLED=false
PISTACHIO_WORKER_SESSION_IDLE_SECONDS=600
PISTACHIO_DEVELOPMENT_INITIAL_REASONING_EFFORT=high
PISTACHIO_DEVELOPMENT_INITIAL_TIMEOUT_SECONDS=300
PISTACHIO_WORKER_SANDBOX=docker
PISTACHIO_DEVELOPMENT_MAX_TURNS=24
PISTACHIO_DEVELOPMENT_MAX_OPERATIONS=12
PISTACHIO_DEVELOPMENT_MAX_REVISIONS=6
PISTACHIO_DEVELOPMENT_SECONDS=1800
PISTACHIO_DEVELOPMENT_WALL_SECONDS=7200
PISTACHIO_DEVELOPMENT_COMMAND_SECONDS=300
PISTACHIO_DEVELOPMENT_ARTIFACT_BYTES=100000000
PISTACHIO_MASTER_PLANNER_MODEL=gpt-5.6-sol
PISTACHIO_WORKER_MODEL=gpt-6-luna
PISTACHIO_WORKER_FALLBACK_MODEL=gpt-5.6-sol
PISTACHIO_WORKER_REASONING_EFFORT=low
PISTACHIO_MASTER_PLANNER_TIMEOUT_SECONDS=180
PISTACHIO_WORKER_TIMEOUT_SECONDS=150
PISTACHIO_EMBEDDING_MODEL=text-embedding-3-small
PISTACHIO_ARTIFACT_ROOT=.pistachio/artifacts
PISTACHIO_DOCKER_ARTIFACT_ROOT=
PISTACHIO_GCP_PROJECT=
PISTACHIO_GCP_REGION=us-central1
PISTACHIO_GCS_BUCKET=
PISTACHIO_GCS_QUARANTINE_BUCKET=
PISTACHIO_BATCH_SERVICE_ACCOUNT=
PISTACHIO_BATCH_IMAGE=
# Staging-only experimental outer-profile exception; leave false without explicit approval.
PISTACHIO_BATCH_NESTED_SANDBOX_OPT_IN=false
PISTACHIO_BATCH_NETWORK=default
PISTACHIO_BATCH_SUBNETWORK=default
PISTACHIO_CLOUD_TASKS_QUEUE=pistachio-tasks
PISTACHIO_CLOUD_TASKS_SERVICE_ACCOUNT=
PISTACHIO_COMPLETION_TOPIC=
PISTACHIO_SLACK_BOT_TOKEN=
PISTACHIO_SLACK_SIGNING_SECRET=
PISTACHIO_SLACK_USER_MAP={}
PISTACHIO_GMAIL_ACCOUNT=
PISTACHIO_GMAIL_PUBSUB_TOPIC=
PISTACHIO_SIGNED_LINK_SECRET=
PISTACHIO_GITHUB_ORG=azizilab
PISTACHIO_GITHUB_APP_TOKEN=
PISTACHIO_TOOL_BUILD_TRIGGER=
PISTACHIO_TOOL_IMAGE_REPOSITORY=
OPENAI_API_KEY=

# New Claude agent for Slack only; existing web configuration above stays in use.
# Existing PISTACHIO_SLACK_BOT_TOKEN and PISTACHIO_GCS_BUCKET are reused automatically.
PISTACHIO_SLACK_AGENT_BACKEND=existing
PISTACHIO_SLACK_AGENT_IMAGE=
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_FALLBACK_MODEL=claude-opus-5
AGENT_DATA_BUCKETS=
AGENT_MEMORY_AUTO_EDIT=true
# Empty uses AGENT_MODEL. This editor runs only after DM replies.
AGENT_MEMORY_MODEL=
AGENT_DATA_PROJECT=
# Explicit staging-only exception required for the inner sandbox's private /proc.
# Also requires PISTACHIO_BATCH_NESTED_SANDBOX_OPT_IN=true and PISTACHIO_ENV=staging.
AGENT_BATCH_PROC_MOUNT_OPT_IN=false
AGENT_DATA_MOUNT_ROOT=/mnt/gcs
AGENT_WORK_ROOT=/srv/pistachio/work
AGENT_STATE_DB=/srv/pistachio/state.db
AGENT_SCI_PYTHON=/opt/sci/bin/python
AGENT_TOOLS_DIR=/opt/pistachio/tools
AGENT_MAX_TURNS=40
AGENT_MAX_BUDGET_USD_PER_TURN=5
AGENT_MAX_CONCURRENT_RUNS=3
# Channel membership replaces the manual Slack map/email/user-ID gates.
AGENT_ACCESS_MODE=channel
# One-time onboarding admins, comma-separated workspace:member IDs (e.g. T123:U123).
# Invite Pistachio and mention it with "enable this channel" to add each access channel.
AGENT_ACCESS_ADMIN_IDS=
AGENT_ACCESS_CACHE_SECONDS=30
# Used only with the explicit legacy AGENT_ACCESS_MODE=mapped setting.
AGENT_ALLOWED_USER_IDS=
AGENT_STORAGE=gcs
AGENT_LOCAL_STORAGE_ROOT=./.local-storage
