MICA_ENV=local
MICA_STORE_BACKEND=memory
MICA_EXECUTION_BACKEND=local
MICA_AUTH_MODE=dev
MICA_ALLOWED_EMAILS=["researcher@example.org"]
MICA_DEV_USER_EMAIL=researcher@example.org
MICA_CONTROL_PLANE_URL=http://localhost:8080
MICA_OIDC_AUDIENCE=
MICA_OPENAI_MODEL=gpt-5.6-sol
MICA_OPENAI_REASONING_EFFORT=medium
MICA_PLANNER_VERSION=2
# Builder protocol 2 is opt-in. See docs/code-builder-implementation.md for release gates.
MICA_BUILDER_PROTOCOL_VERSION=1
MICA_DEVELOPMENT_ENABLED=false
MICA_DEVELOPMENT_MODEL=gpt-5.6-sol
MICA_DEVELOPMENT_PREPARATION_ENABLED=true
# Version 2: enable only after matched-image and scientific conformance checks.
MICA_DEVELOPMENT_LATENCY_ENABLED=false
MICA_WORKER_SESSIONS_ENABLED=false
MICA_WORKER_SESSION_IDLE_SECONDS=600
MICA_DEVELOPMENT_INITIAL_REASONING_EFFORT=high
MICA_DEVELOPMENT_INITIAL_TIMEOUT_SECONDS=300
MICA_WORKER_SANDBOX=docker
MICA_DEVELOPMENT_MAX_TURNS=24
MICA_DEVELOPMENT_MAX_OPERATIONS=12
MICA_DEVELOPMENT_MAX_REVISIONS=6
MICA_DEVELOPMENT_SECONDS=1800
MICA_DEVELOPMENT_WALL_SECONDS=7200
MICA_DEVELOPMENT_COMMAND_SECONDS=300
MICA_DEVELOPMENT_ARTIFACT_BYTES=100000000
MICA_MASTER_PLANNER_MODEL=gpt-5.6-sol
MICA_WORKER_MODEL=gpt-6-luna
MICA_WORKER_FALLBACK_MODEL=gpt-5.6-sol
MICA_WORKER_REASONING_EFFORT=low
MICA_MASTER_PLANNER_TIMEOUT_SECONDS=180
MICA_WORKER_TIMEOUT_SECONDS=150
MICA_EMBEDDING_MODEL=text-embedding-3-small
MICA_ARTIFACT_ROOT=.pistachio/artifacts
MICA_DOCKER_ARTIFACT_ROOT=
MICA_GCP_PROJECT=
MICA_GCP_REGION=us-central1
MICA_GCS_BUCKET=
MICA_GCS_QUARANTINE_BUCKET=
MICA_BATCH_SERVICE_ACCOUNT=
MICA_BATCH_IMAGE=
# Staging-only experimental outer-profile exception; leave false without explicit approval.
MICA_BATCH_NESTED_SANDBOX_OPT_IN=false
MICA_BATCH_NETWORK=default
MICA_BATCH_SUBNETWORK=default
MICA_CLOUD_TASKS_QUEUE=mica-tasks
MICA_CLOUD_TASKS_SERVICE_ACCOUNT=
MICA_COMPLETION_TOPIC=
MICA_SLACK_BOT_TOKEN=
MICA_SLACK_SIGNING_SECRET=
MICA_SLACK_USER_MAP={}
MICA_GMAIL_ACCOUNT=
MICA_GMAIL_PUBSUB_TOPIC=
MICA_SIGNED_LINK_SECRET=
MICA_GITHUB_ORG=azizilab
MICA_GITHUB_APP_TOKEN=
MICA_TOOL_BUILD_TRIGGER=
MICA_TOOL_IMAGE_REPOSITORY=
OPENAI_API_KEY=

# Claude agent for Slack; shared headless service configuration is above.
# Existing MICA_SLACK_BOT_TOKEN and MICA_GCS_BUCKET are reused automatically.
MICA_SLACK_AGENT_BACKEND=existing
MICA_SLACK_AGENT_IMAGE=
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
AGENT_LOADING_EMOJI=:hourglass_flowing_sand:
AGENT_FALLBACK_MODEL=claude-opus-5
AGENT_DATA_BUCKETS=
AGENT_MEMORY_AUTO_EDIT=true
# Empty uses AGENT_MODEL. This editor runs only after DM replies.
AGENT_MEMORY_MODEL=
AGENT_DATA_PROJECT=
# Explicit staging-only exception required for the inner sandbox's private /proc.
# Also requires MICA_BATCH_NESTED_SANDBOX_OPT_IN=true and MICA_ENV=staging.
AGENT_BATCH_PROC_MOUNT_OPT_IN=false
AGENT_DATA_MOUNT_ROOT=/mnt/gcs
AGENT_WORK_ROOT=/srv/pistachio/work
AGENT_STATE_DB=/srv/pistachio/state.db
AGENT_SCI_PYTHON=/opt/sci/bin/python
AGENT_TOOLS_DIR=/opt/pistachio/tools
AGENT_MAX_TURNS=500
AGENT_MAX_BUDGET_USD_PER_TURN=5
AGENT_MAX_CONCURRENT_RUNS=3
# Channel membership replaces the manual Slack map/email/user-ID gates.
AGENT_ACCESS_MODE=channel
# One-time onboarding admins, comma-separated workspace:member IDs (e.g. T123:U123).
# Invite Mica and mention it with "enable this channel" to add each access channel.
AGENT_ACCESS_ADMIN_IDS=
AGENT_ACCESS_CACHE_SECONDS=30
# Used only with the explicit legacy AGENT_ACCESS_MODE=mapped setting.
AGENT_ALLOWED_USER_IDS=
AGENT_STORAGE=gcs
AGENT_LOCAL_STORAGE_ROOT=./.local-storage
