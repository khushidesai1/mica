# Merge with the EXISTING Cloud Run configuration; never replace it wholesale.
PISTACHIO_SLACK_AGENT_BACKEND=existing
PISTACHIO_SLACK_AGENT_IMAGE=
# Existing PISTACHIO_GCS_BUCKET, bot token, signing secret, user map, control URL,
# Cloud Tasks queue, region, worker SA and network settings are reused.
# Map ANTHROPIC_API_KEY from Secret Manager in Cloud Run; never put the value here.
AGENT_DATA_BUCKETS=
# Handle conversation and brief updates directly; reserve Spot for computation.
AGENT_MEMORY_AUTO_EDIT=true
# Empty uses AGENT_MODEL. This editor runs only after DM replies.
AGENT_MEMORY_MODEL=
# Set to azizilab-aml to discover its buckets for init and computation requests.
AGENT_DATA_PROJECT=
# Staging-only, separately approved; requires existing nested sandbox opt-in.
AGENT_BATCH_PROC_MOUNT_OPT_IN=false
AGENT_MODEL=claude-opus-5-5
AGENT_FALLBACK_MODEL=claude-opus-5
AGENT_MAX_TURNS=40
AGENT_MAX_BUDGET_USD_PER_TURN=5
AGENT_MAX_CONCURRENT_RUNS=3
# Slack upload limits (API only). Stored originals expire under the 30-day tasks lifecycle.
AGENT_ATTACHMENT_MAX_FILES=10
AGENT_ATTACHMENT_MAX_MB=100
AGENT_ATTACHMENT_MAX_MESSAGE_MB=250
# Channel membership replaces the manual Slack map/email/user-ID gates.
# Use workspace for private agent DMs for verified workspace members without an access channel.
# Projects remain private until explicitly shared/published, including in workspace mode.
AGENT_ACCESS_MODE=channel
# One-time onboarding admins, comma-separated workspace:member IDs (e.g. T123:U123).
# Invite Pistachio and mention it with "enable this channel" to add each access channel.
AGENT_ACCESS_ADMIN_IDS=
AGENT_ACCESS_CACHE_SECONDS=30
# Existing progress dropdown only: first check-in at 10 minutes, then every 2 hours.
AGENT_LONG_RUN_THRESHOLD_SECONDS=600
AGENT_LONG_RUN_UPDATE_SECONDS=7200
# Seven-day task ceiling for new analysis and transfer-pull jobs; no automatic retry.
AGENT_MAX_RUN_SECONDS=604800
# GCS output grants: disabled until all three settings below are configured.
# These admins also need membership in the selected Pistachio project.
AGENT_WRITE_ADMIN_IDS=
# Maximum destinations, for example gs://lab-outputs/project-a/,gs://lab-outputs/project-b/
AGENT_WRITE_ALLOWED_PREFIXES=
# Dedicated create/get-only service account, impersonated only by the control service.
AGENT_WRITE_SERVICE_ACCOUNT=
AGENT_WRITE_MAX_MB=512
# Used only with the explicit legacy AGENT_ACCESS_MODE=mapped setting.
AGENT_ALLOWED_USER_IDS=
# Worker paths are baked into the image and remain identical between Spot jobs.
# No SLACK_APP_TOKEN is needed for the existing HTTP webhook.

# Public package runtimes: keep disabled until approved staging canaries pass.
AGENT_RUNTIMES_ENABLED=false
AGENT_RUNTIME_ROOT=/srv/pistachio/runtimes
AGENT_RUNTIME_MIN_AGE_DAYS=7
AGENT_RUNTIME_MAX_GB=8
AGENT_RUNTIME_MAX_NEW_PER_TURN=3
AGENT_RUNTIME_TIMEOUT_SECONDS=900
AGENT_RUNTIME_MAX_LOCAL_GB=60
AGENT_RUNTIME_DENYLIST=
