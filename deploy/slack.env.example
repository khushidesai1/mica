# Merge with the EXISTING Cloud Run configuration; never replace it wholesale.
PISTACHIO_SLACK_AGENT_BACKEND=existing
PISTACHIO_SLACK_AGENT_IMAGE=
# Existing PISTACHIO_GCS_BUCKET, bot token, signing secret, user map, control URL,
# Cloud Tasks queue, region, worker SA and network settings are reused.
# Map ANTHROPIC_API_KEY from Secret Manager in Cloud Run; never put the value here.
AGENT_DATA_BUCKETS=
# Handle conversation and brief updates directly; reserve Spot for computation.
AGENT_DIRECT_CHAT_ENABLED=true
# Set to azizilab-aml to discover its buckets for init and computation requests.
AGENT_DATA_PROJECT=
# Staging-only, separately approved; requires existing nested sandbox opt-in.
AGENT_BATCH_PROC_MOUNT_OPT_IN=false
AGENT_MODEL=claude-opus-5-5
AGENT_FALLBACK_MODEL=claude-opus-5
AGENT_MAX_TURNS=40
AGENT_MAX_BUDGET_USD_PER_TURN=5
AGENT_MAX_CONCURRENT_RUNS=3
AGENT_ALLOWED_USER_IDS=
# Worker paths are baked into the image and remain identical between Spot jobs.
# No SLACK_APP_TOKEN is needed for the existing HTTP webhook.
